<?xml version="1.0"?>
<robot name="glados_robot">
  <!-- LINKS -->
  <link name="ceiling_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Placeholder geometry -->
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <link name="robot_top_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.4" radius="0.1"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.4" radius="0.1"/>
      </geometry>
    </collision>
  </link>

  <link name="body_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Minimal placeholder geometry -->
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </visual>
  </link>

  <link name="neck_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Minimal placeholder geometry -->
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </visual>
  </link>

  <link name="head_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Minimal placeholder geometry -->
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </visual>
  </link>

  <!-- JOINTS -->
  <joint name="ceiling_to_top" type="revolute">
    <parent link="ceiling_link"/>
    <child link="robot_top_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="3.14159" effort="10" velocity="1.0"/>
  </joint>

  <joint name="top_to_body" type="revolute">
    <parent link="robot_top_link"/>
    <child link="body_link"/>
    <origin xyz="0 0 0.250796" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="3.14159" effort="10" velocity="1.0"/>
  </joint>

  <joint name="neck_left_right" type="revolute">
    <parent link="body_link"/>
    <child link="neck_link"/>
    <origin xyz="0 0 0.0641735" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.907" upper="2.094" effort="10" velocity="1.0"/>
  </joint>

  <joint name="head_up_down" type="revolute">
    <parent link="neck_link"/>
    <child link="head_link"/>
    <origin xyz="0 0 0.083705" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.105" upper="2.182" effort="10" velocity="1.0"/>
  </joint>
</robot>

